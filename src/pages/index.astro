---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type Post = CollectionEntry<"posts">;

function comparePostsByPublishDate(a: Post, b: Post) {
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
}

const allPosts = await getCollection("posts");
const publishedPosts = allPosts
  .filter((post) => !post.data.isDraft)
  .sort(comparePostsByPublishDate);
---

<BaseLayout>
  <div class="posts">
    {
      publishedPosts.map((post) => (
        <div class="post">
          <h3>
            <a href={`/posts/${post.id}`}>{post.data.title}</a>
          </h3>
          <aside>{post.data.excerpt}</aside>
        </div>
      ))
    }
  </div>
</BaseLayout>

<script>
  const POSTS_CONTAINER_SELECTOR = ".posts";
  const NAVIGATING_CLASS = "is-navigating";
  const ACTIVE_POST_CLASS = "is-active";

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const link = target?.closest("a");
    if (!link) return;

    const postsContainer = link.closest(POSTS_CONTAINER_SELECTOR);
    if (!postsContainer) return;

    const isModifiedClick =
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey ||
      event.button !== 0;
    if (isModifiedClick) return;

    const post = link.closest(".post");
    postsContainer.classList.add(NAVIGATING_CLASS);
    post?.classList.add(ACTIVE_POST_CLASS);
  });
</script>

<style>
  div.post {
    margin-bottom: 3rem;
    transition: opacity 150ms ease;
  }

  .posts.is-navigating div.post:not(.is-active) {
    opacity: 0.1;
  }

  @media (prefers-reduced-motion: reduce) {
    div.post {
      transition: none;
    }
  }

  h3 {
    font-size: 2.2rem;
    margin-bottom: 0.8rem;
  }

  h3 a {
    text-decoration: underline;
    text-underline-offset: 10px;
    text-decoration-color: var(--colorful);
    text-decoration-thickness: 4px;
  }

  @media (max-width: 600px) {
    h3 {
      font-size: max(6vw, 1.5rem);
    }
  }
</style>
