---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type Post = CollectionEntry<"posts">;

function comparePostsByPublishDate(a: Post, b: Post) {
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
}

const allPosts = await getCollection("posts");
const publishedPosts = allPosts
  .filter((post) => !post.data.isDraft)
  .sort(comparePostsByPublishDate);
---

<BaseLayout>
  <div class="posts">
    {
      publishedPosts.map((post) => (
        <div class="post">
          <h3>
            <a href={`/posts/${post.id}`}>{post.data.title}</a>
          </h3>
          <aside>{post.data.excerpt}</aside>
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  div.post {
    margin-bottom: 3rem;
    transition: opacity 150ms ease;
  }

  .posts:focus-within div.post:not(:focus-within) {
    opacity: 0.1;
  }

  @media (prefers-reduced-motion: reduce) {
    div.post {
      transition: none;
    }
  }

  h3 {
    font-size: 2.2rem;
    margin-bottom: 0.8rem;
  }

  h3 a {
    text-decoration: underline;
    text-underline-offset: 10px;
    text-decoration-color: var(--colorful);
    text-decoration-thickness: 4px;
  }

  @media (max-width: 600px) {
    h3 {
      font-size: max(6vw, 1.5rem);
    }
  }
</style>
